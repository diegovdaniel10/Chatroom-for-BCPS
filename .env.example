# Copy to .env (run.bat does this for you). Never commit .env.
APP_ENV=development
DEMO_MODE=true
HOST=127.0.0.1
PORT=3000
# Required (32+ chars) when APP_ENV=production. In development a secret is generated in data/.dev_session_secret.
SESSION_SECRET=
# Optional: exact origins allowed to call the API (comma separated). Default: same host only.
ALLOWED_ORIGINS=
# Optional: SQLite path, e.g. sqlite:///data/chat.db (default). PostgreSQL is NOT implemented yet.
DATABASE_URL=
# Optional: fixed single-use owner claim code for the first Owner. Default: random, printed in the console.
OWNER_CLAIM_CODE=
